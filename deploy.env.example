# Settings for docker-compose.yml. Copy to deploy.env (kept out of git) and fill in.
#   docker compose --env-file deploy.env up -d --build

# Long random values made of letters and digits only (they go inside URLs), for example from:
#   openssl rand -hex 32
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ADMIN_TOKEN=

# Where riders reach the server, behind your HTTPS reverse proxy.
PUBLIC_URL=https://bus.example.in
APP_PORT=8080

# Optional; see README.md, "Server settings".
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
OSRM_URL=
TRIP_HISTORY_DAYS=90
WORKERS=
SERVER_ID=bus-1
