{
  "name": "@wimb/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Where Is My Bus API, live tracking and admin panel. Keeps its data in files, or in PostgreSQL and Redis when DATABASE_URL and REDIS_URL are set.",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.ts",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "test:db": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --test test/databases.test.ts",
    "start:cluster": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/cluster.ts",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "redis": "^6.3.1"
  }
}
