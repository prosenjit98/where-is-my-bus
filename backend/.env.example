# Copy to .env (kept out of git) and change what you need. npm start and npm run dev read .env.
# Without DATABASE_URL and REDIS_URL the server keeps its data in files next to the network file.

# PostgreSQL: the network, owners and buses, trips, recordings, suggestions, learned travel times.
DATABASE_URL=postgres://wimb@localhost:5432/wimb
# DATABASE_SCHEMA=public

# Redis: one-time codes, follow links, riders' reports, and live updates shared between servers.
REDIS_URL=redis://localhost:6379
# REDIS_PREFIX=wimb:

# This server's name among several; the same after a restart. The computer's name when missing.
# SERVER_ID=bus-1

# The network a new server or an empty database starts from (npm run seed loads one by hand).
# The demo network when missing. Paths are relative to backend/.
SEED_FILE=../data/seed-kolkata.json
